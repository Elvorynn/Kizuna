<Controls:MetroWindow x:Class="Kizuna.LibraryRuleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        Title="Edit Rule" Height="450" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowMinButton="False" ShowMaxRestoreButton="False">

    <Controls:MetroWindow.Resources>
        <!-- Match main window title bar -->
        <SolidColorBrush x:Key="AccentColorBrush"               Color="#1E1E1E"/>
        <SolidColorBrush x:Key="WindowTitleColorBrush"          Color="#1E1E1E"/>
        <SolidColorBrush x:Key="WindowTitleBackground"          Color="#1E1E1E"/>
        <SolidColorBrush x:Key="NonActiveWindowTitleColorBrush" Color="#161616"/>
        <SolidColorBrush x:Key="NonActiveWindowTitleBrush"      Color="#161616"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="Foreground"        Value="#888888"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,0,10,0"/>
            <Setter Property="MinWidth"          Value="128"/>
        </Style>
        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#CF6679"/>
            <Setter Property="Margin"     Value="138,3,0,4"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- Dark button template shared by OK/Cancel and Browse buttons -->
        <ControlTemplate x:Key="DarkBtnTemplate" TargetType="Button">
            <Border x:Name="Bd" Background="#2D2D2D" BorderBrush="#484848"
                    BorderThickness="1" CornerRadius="3">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#464646"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Background" Value="#252526"/>
                    <Setter Property="Foreground"                  Value="#555555"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="RuleButton" TargetType="Button">
            <Setter Property="Height"    Value="32"/>
            <Setter Property="Width"     Value="88"/>
            <Setter Property="FontSize"  Value="12"/>
            <Setter Property="Padding"   Value="0"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Template"  Value="{StaticResource DarkBtnTemplate}"/>
        </Style>
        <Style x:Key="BrowseButton" TargetType="Button">
            <Setter Property="Width"     Value="34"/>
            <Setter Property="Padding"   Value="0"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Template"  Value="{StaticResource DarkBtnTemplate}"/>
        </Style>
    </Controls:MetroWindow.Resources>

    <Grid Margin="22,12,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Fields ───────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" VerticalAlignment="Top">

            <!-- Name -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtLblName" Grid.Column="0" Text="Name" Style="{StaticResource FieldLabel}"/>
                <TextBox   x:Name="TxtName"    Grid.Column="1"/>
            </Grid>

            <!-- Source Path -->
            <Grid Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtLblSource" Grid.Column="0" Text="Source Path" Style="{StaticResource FieldLabel}"/>
                <TextBox   x:Name="TxtSourcePath" Grid.Column="1"
                           TextChanged="TxtSourcePath_TextChanged"/>
                <Button    x:Name="BtnBrowseSource" Grid.Column="2" Content="…"
                           Style="{StaticResource BrowseButton}"
                           Margin="6,0,0,0" Click="BtnBrowseSource_Click"/>
            </Grid>
            <TextBlock x:Name="TxtSourceError" Style="{StaticResource FieldError}"/>

            <!-- Match subfolders -->
            <CheckBox x:Name="ChkMatchSubfolders" Margin="138,0,0,12"
                      Foreground="#CCCCCC" FontSize="11.5"/>

            <!-- Target Base Path -->
            <Grid Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtLblTarget" Grid.Column="0" Text="Target Base Path" Style="{StaticResource FieldLabel}"/>
                <TextBox   x:Name="TxtTargetPath" Grid.Column="1"
                           TextChanged="TxtTargetPath_TextChanged"/>
                <Button    x:Name="BtnBrowseTarget" Grid.Column="2" Content="…"
                           Style="{StaticResource BrowseButton}"
                           Margin="6,0,0,0" Click="BtnBrowseTarget_Click"/>
            </Grid>
            <TextBlock x:Name="TxtTargetError" Style="{StaticResource FieldError}"/>

            <!-- Folder structure options -->
            <CheckBox x:Name="ChkFranchiseFolder" Margin="138,8,0,8"
                      Foreground="#CCCCCC" FontSize="11.5"
                      Checked="ChkFranchiseFolder_Changed"
                      Unchecked="ChkFranchiseFolder_Changed"/>
            <CheckBox x:Name="ChkSeasonFolder" Margin="158,0,0,8"
                      Foreground="#CCCCCC" FontSize="11.5"
                      ToolTip="Files are placed flat in the franchise folder at first.&#x0a;When a second season is detected, the existing files are&#x0a;automatically moved into a season subfolder and a new&#x0a;season subfolder is created for the new season."/>

            <!-- Filename option -->
            <CheckBox x:Name="ChkCleanFilename" Margin="138,0,0,4"
                      Foreground="#CCCCCC" FontSize="11.5"/>
            <TextBlock Foreground="#555555" FontSize="10" Margin="158,0,0,0"
                       Text="[Group] Title - 04 (1080p) [AB12CD34].mkv  →  Title - 04.mkv"/>

        </StackPanel>

        <!-- ── OK / Cancel ───────────────────────────────────────────────── -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnOk"     Style="{StaticResource RuleButton}" Margin="0,0,8,0" Click="BtnOk_Click"/>
            <Button x:Name="BtnCancel" Style="{StaticResource RuleButton}" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Controls:MetroWindow>
