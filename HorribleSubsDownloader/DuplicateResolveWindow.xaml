<Controls:MetroWindow x:Class="Kizuna.DuplicateResolveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        Title="Resolve Duplicate"
        Height="420" Width="720"
        WindowStartupLocation="CenterOwner"
        ShowMinButton="False" ShowMaxRestoreButton="False">

    <Grid Margin="22,16,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header  -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>     <!-- file list -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>  <!-- summary -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- buttons -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TxtHeader"
                       Foreground="#DDDDDD" FontSize="14" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="Tick the copies you want to KEEP. Every un-ticked copy will be deleted."
                       Foreground="#888888" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="2" Background="#1E1E1E" BorderBrush="#3C3C3C" BorderThickness="1"
                CornerRadius="4">
            <ItemsControl x:Name="LstFiles" Margin="4">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,6" Margin="2" CornerRadius="3"
                                Background="#252526">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="Keep"
                                          Foreground="#CCCCCC" VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          IsChecked="{Binding Keep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FullPath}"
                                               Foreground="{Binding PathBrush}"
                                               FontFamily="Consolas" FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FullPath}"/>
                                    <TextBlock Text="{Binding ActionText}"
                                               Foreground="{Binding ActionBrush}"
                                               FontSize="10" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="▶" Height="22" FontSize="9"
                                        Padding="8,0" MinWidth="30" VerticalAlignment="Center"
                                        ToolTip="Open in default media player"
                                        Click="BtnPlay_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock Grid.Row="4" x:Name="TxtSummary"
                   Foreground="#9CDCFE" FontSize="11"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="110" Margin="0,0,8,0"
                    IsCancel="True" Click="BtnCancel_Click"
                    Style="{DynamicResource SquareButtonStyle}"/>
            <Button Content="Delete unticked" Width="150"
                    IsDefault="True" Click="BtnOk_Click"
                    Style="{DynamicResource AccentedSquareButtonStyle}"/>
        </StackPanel>
    </Grid>
</Controls:MetroWindow>
