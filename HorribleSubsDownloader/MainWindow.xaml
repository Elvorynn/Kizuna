<Controls:MetroWindow x:Class="Kizuna.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:local="clr-namespace:Kizuna"
        mc:Ignorable="d"
        Title="Kizuna"
        Height="860" Width="1600" MinHeight="620" MinWidth="920"
        GlowBrush="#647687"
        NonActiveGlowBrush="#2D2D2D"
        ShowMinButton="False"
        ShowMaxRestoreButton="False"
        ShowCloseButton="False"
        Loaded="Window_Loaded" Closing="Window_Closing" StateChanged="Window_StateChanged">

    <Controls:MetroWindow.Resources>

        <!-- ── Colours ───────────────────────────────────────────────────────── -->
        <SolidColorBrush x:Key="PanelBg"       Color="#252526"/>
        <SolidColorBrush x:Key="PanelHeaderBg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="PanelBorder"   Color="#3C3C3C"/>

        <!-- ── Title bar (MahApps window chrome) ─────────────────────────────── -->
        <!-- AccentColorBrush is what MahApps uses for the title bar background.  -->
        <!-- Override it to dark here so the chrome matches the rest of the app.  -->
        <!-- GlowBrush is hardcoded to Steel so it keeps the accent glow.         -->
        <SolidColorBrush x:Key="AccentColorBrush"               Color="#1E1E1E"/>
        <SolidColorBrush x:Key="WindowTitleColorBrush"          Color="#1E1E1E"/>
        <SolidColorBrush x:Key="WindowTitleBackground"          Color="#1E1E1E"/>
        <SolidColorBrush x:Key="NonActiveWindowTitleColorBrush" Color="#161616"/>
        <SolidColorBrush x:Key="NonActiveWindowTitleBrush"      Color="#161616"/>

        <!-- ── Converters ─────────────────────────────────────────────────────── -->
        <local:PathMissingToVisibleConverter   x:Key="PathMissingToVisible"/>
        <local:PathExistsToForegroundConverter x:Key="PathExistsToFg"/>
        <local:BoolToVisibleConverter          x:Key="BoolToVisible"/>
        <local:InverseBoolToVisibleConverter   x:Key="InvBoolToVisible"/>

        <!-- ── Shared collection view for Library Manager grids ──────────────── -->
        <CollectionViewSource x:Key="ScanResultsView"/>

        <!-- ── Dynamic string resources ──────────────────────────────────────── -->
        <sys:String x:Key="KeySetRule">Set Rule</sys:String>
        <sys:String x:Key="KeyDownload">Download</sys:String>

        <!-- ── Panel header text ─────────────────────────────────────────────── -->
        <Style x:Key="PanelHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="10.5"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground"        Value="#9A9A9A"/>
        </Style>

        <!-- ── Sub-tab (Scan Results / Move Queue); active state via Tag="active" ─ -->
        <Style x:Key="SubTab" TargetType="Button">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding"    Value="14,0"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#9CDCFE"/>
                                <Setter TargetName="Bd" Property="Background"   Value="#1C1C1C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Navigation tab button ─────────────────────────────────────────── -->
        <Style x:Key="NavTabButton" TargetType="Button">
            <Setter Property="Height"   Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding"  Value="16,0"/>
            <Setter Property="Margin"   Value="0"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C1C1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252525"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Frameless icon button ─────────────────────────────────────────── -->
        <Style x:Key="PanelIconButton" TargetType="Button">
            <Setter Property="Width"   Value="28"/>
            <Setter Property="Height"  Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor"  Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.FontSize="13"
                                              TextElement.Foreground="#555555"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                                <Setter Property="Foreground"                  Value="#BBBBBB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#444444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Main action buttons ───────────────────────────────────────────── -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height"   Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding"  Value="16,0"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="#2A2A2A"
                                BorderBrush="#484848"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"   Value="#3A3A3A"/>
                                <Setter TargetName="Bd" Property="BorderBrush"  Value="#606060"/>
                                <Setter Property="Foreground"                    Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1A1A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#555555"/>
                                <Setter TargetName="Bd" Property="Background" Value="#1E1E1E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Download All button ───────────────────────────────────────────── -->
        <Style x:Key="DownloadAllButton" TargetType="Button">
            <Setter Property="Height"     Value="34"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding"    Value="16,0"/>
            <Setter Property="Foreground" Value="#78C878"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="#1A3020"
                                BorderBrush="#2C5030"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="#224030"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A6840"/>
                                <Setter Property="Foreground"                   Value="#96D896"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#122018"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Download All split button – left (main) part ─────────────────── -->
        <Style x:Key="DownloadAllButtonMain" TargetType="Button">
            <Setter Property="Height"     Value="34"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding"    Value="16,0"/>
            <Setter Property="Foreground" Value="#78C878"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#1A3020" BorderBrush="#2C5030"
                                BorderThickness="1,1,0,1" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="#224030"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A6840"/>
                                <Setter Property="Foreground" Value="#96D896"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#122018"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Download All split button – right (dropdown) part ─────────────── -->
        <Style x:Key="DownloadAllButtonSide" TargetType="Button">
            <Setter Property="Height"     Value="34"/>
            <Setter Property="Width"      Value="46"/>
            <Setter Property="Foreground" Value="#78C878"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#1A3020" BorderBrush="#2C5030"
                                BorderThickness="1,1,1,1" SnapsToDevicePixels="True">
                            <Grid>
                                <Border Background="#2C5030" Width="1" HorizontalAlignment="Left"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="#224030"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A6840"/>
                                <Setter Property="Foreground" Value="#96D896"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#122018"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DataGrid row-action button ────────────────────────────────────── -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Height"     Value="26"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Padding"    Value="10,0"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="#2A2A2A"
                                BorderBrush="#484848"
                                BorderThickness="1"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="#3A3A3A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#666666"/>
                                <Setter Property="Foreground"                   Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1A1A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DataGrid column-header style ──────────────────────────────────── -->
        <Style x:Key="ColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Height"          Value="32"/>
            <Setter Property="FontSize"        Value="10.5"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="Foreground"      Value="#888888"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="Background"      Value="#1E1E1E"/>
            <Setter Property="BorderBrush"     Value="#333333"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <!-- ── DataGrid cell style ───────────────────────────────────────────── -->
        <Style x:Key="Cell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentColorBrush3}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Controls:MetroWindow.Resources>

    <!-- ── Title bar: app badge (left) ──────────────────────────────────── -->
    <Controls:MetroWindow.LeftWindowCommands>
        <Controls:WindowCommands>
            <Button Focusable="False" IsHitTestVisible="False" Style="{x:Null}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#252526"
                                CornerRadius="3" Width="22" Height="22" Margin="4,0,0,0">
                            <TextBlock Text="K" FontWeight="Bold" FontSize="11"
                                       Foreground="#9CDCFE"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Controls:WindowCommands>
    </Controls:MetroWindow.LeftWindowCommands>

    <!-- ── Title bar: countdown + window menu (right of title) ─────────── -->
    <Controls:MetroWindow.RightWindowCommands>
        <Controls:WindowCommands>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0">
                <TextBlock x:Name="TxtBatchStatus"
                           Visibility="Collapsed"
                           Foreground="#9CDCFE"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0"
                           FontSize="11"/>
                <!-- CboDelay kept hidden for code-behind compat; delay is now on the split button -->
                <TextBlock x:Name="TxtDelayLabel"  Visibility="Collapsed" FontSize="1"/>
                <ComboBox  x:Name="CboDelay"       Visibility="Collapsed" Width="0" Height="0"
                           SelectionChanged="CboDelay_SelectionChanged"/>

                <!-- Window controls -->
                <Button x:Name="BtnMinimize" Width="40" Height="30" Focusable="False"
                        ToolTip="Minimieren" Click="MenuItemMinimize_Click" Style="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent">
                                <TextBlock x:Name="Ic" Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           Foreground="#BBBBBB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                                    <Setter TargetName="Ic" Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="BtnMaxRestore" Width="40" Height="30" Focusable="False"
                        ToolTip="Maximieren" Click="MenuItemMaxRestore_Click" Style="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent">
                                <TextBlock x:Name="Ic" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           Foreground="#BBBBBB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                                    <Setter TargetName="Ic" Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="BtnClose" Width="40" Height="30" Focusable="False"
                        ToolTip="Schließen" Click="MenuItemClose_Click" Style="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent">
                                <TextBlock x:Name="Ic" Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           Foreground="#BBBBBB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                    <Setter TargetName="Ic" Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F1707A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Controls:WindowCommands>
    </Controls:MetroWindow.RightWindowCommands>

    <!-- ══════════════════════════════════════════════════════════════════════
         MAIN GRID — nav bar | view content | event log
    ══════════════════════════════════════════════════════════════════════ -->
    <Grid x:Name="GridMain" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>   <!-- navigation bar          -->
            <RowDefinition Height="*"/>    <!-- view content            -->
            <RowDefinition x:Name="LogRow" Height="148"/>  <!-- event log               -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════
             ROW 0 — Navigation bar
        ══════════════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    VerticalAlignment="Bottom" Margin="0,0,0,6">
            <Grid Margin="0,0,2,0">
                <Button x:Name="BtnNavDownloadManager"
                        Content="Download Manager"
                        Style="{StaticResource NavTabButton}"
                        Click="BtnNavDownloadManager_Click"/>
                <Border x:Name="BorderNavDlActive"
                        Height="2" VerticalAlignment="Bottom"
                        Background="#647687"
                        HorizontalAlignment="Stretch"/>
            </Grid>
            <Grid Margin="0,0,2,0">
                <Button x:Name="BtnNavLibraryManager"
                        Content="Library Manager"
                        Style="{StaticResource NavTabButton}"
                        Click="BtnNavLibraryManager_Click"/>
                <Border x:Name="BorderNavLibActive"
                        Height="2" VerticalAlignment="Bottom"
                        Background="#647687"
                        HorizontalAlignment="Stretch"
                        Visibility="Collapsed"/>
            </Grid>
            <Grid>
                <Button x:Name="BtnNavDuplicateFinder"
                        Content="Duplicate Finder"
                        Style="{StaticResource NavTabButton}"
                        Click="BtnNavDuplicateFinder_Click"/>
                <Border x:Name="BorderNavDupActive"
                        Height="2" VerticalAlignment="Bottom"
                        Background="#647687"
                        HorizontalAlignment="Stretch"
                        Visibility="Collapsed"/>
            </Grid>
        </StackPanel>

        <!-- ══════════════════════════════════════════════════════════════
             ROW 1 — Download Manager view
        ══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="ViewDownloadManager" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>    <!-- data panels         -->
                <RowDefinition Height="52"/>   <!-- action-button strip -->
            </Grid.RowDefinitions>

            <!-- ── Two panels + splitter ───────────────────────────── -->
            <Grid x:Name="GridPanels" Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"  MinWidth="200"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="2*" MinWidth="200"/>
                </Grid.ColumnDefinitions>

                <!-- ── LEFT PANEL: Unrecognized files ─────────────── -->
                <Border x:Name="BorderLeft" Grid.Column="0"
                        Background="{StaticResource PanelBg}"
                        BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1" CornerRadius="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource PanelHeaderBg}"
                                CornerRadius="4,4,0,0" Padding="12,0">
                            <Grid>
                                <TextBlock x:Name="TxtHeaderUnrecognized"
                                           Style="{StaticResource PanelHeaderText}"
                                           Text="UNRECOGNIZED FILES"
                                           VerticalAlignment="Center"/>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Border Background="#1C1C1C" CornerRadius="2"
                                            BorderBrush="#3C3C3C" BorderThickness="1"
                                            Width="120" Height="22" Margin="0,0,6,0">
                                        <TextBox x:Name="TxtSearchUnrecognized"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="#CCCCCC" FontSize="10"
                                                 VerticalAlignment="Center"
                                                 Controls:TextBoxHelper.Watermark="Filter…"
                                                 Controls:TextBoxHelper.UseFloatingWatermark="False"
                                                 TextChanged="TxtSearchUnrecognized_TextChanged"/>
                                    </Border>
                                    <Button x:Name="BtnMaxLeft" Content="⤢"
                                            Style="{StaticResource PanelIconButton}"
                                            Click="BtnMaxLeft_Click"
                                            ToolTip="Maximize panel"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1" x:Name="GridUnrecognized"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" SelectionMode="Single"
                                  GridLinesVisibility="None" RowHeight="36"
                                  Background="Transparent" BorderThickness="0"
                                  ColumnHeaderStyle="{StaticResource ColHeader}"
                                  CellStyle="{StaticResource Cell}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID"       Binding="{Binding Id}"   Width="SizeToCells" MinWidth="52"/>
                                <DataGridTextColumn Header="FILENAME" Binding="{Binding Name}" Width="*"/>
                                <DataGridTemplateColumn Header="" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Click="BtnSetRule_Click"
                                                    Content="{DynamicResource KeySetRule}"
                                                    Style="{StaticResource RowButton}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="1" x:Name="PanelUnrecognizedEmpty"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Background="#2D2D2D" CornerRadius="40"
                                    Width="72" Height="72" HorizontalAlignment="Center">
                                <TextBlock Text="∅" FontSize="34" FontFamily="Segoe UI"
                                           Foreground="#666666"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="TxtEmptyUnrecTitle"
                                       Text="No unrecognized files"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#AAAAAA"
                                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            <TextBlock x:Name="TxtEmptyUnrecSub"
                                       Text="All files are already matched to rules."
                                       FontSize="11" Foreground="#666666"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" x:Name="PanelUnrecognizedError"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Background="#2E1F1F" CornerRadius="40"
                                    Width="72" Height="72" HorizontalAlignment="Center">
                                <TextBlock Text="⚠" FontSize="30" Foreground="#D97070"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="TxtErrUnrecTitle"
                                       Text="Could not load files"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#AAAAAA"
                                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            <TextBlock x:Name="TxtErrUnrecSub"
                                       Text="Check your connection and settings."
                                       FontSize="11" Foreground="#666666"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border x:Name="PanelLeftCollapsedOverlay"
                                Grid.Row="1"
                                Background="{StaticResource PanelBg}"
                                Visibility="Collapsed"
                                Panel.ZIndex="10"
                                Cursor="Hand"
                                MouseLeftButtonDown="PanelCollapsedOverlay_Click"
                                ToolTip="Click to restore layout">
                            <TextBlock x:Name="TxtCollapsedLeft"
                                       Text="UNRECOGNIZED FILES"
                                       Foreground="#909090"
                                       FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="-90"/>
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </Border>

                    </Grid>
                </Border>

                <!-- ── GRID SPLITTER ──────────────────────────────── -->
                <GridSplitter x:Name="SplitterPanels" Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Columns"
                              Background="#3C3C3C" Cursor="SizeWE"/>

                <!-- ── RIGHT PANEL: Download queue ────────────────── -->
                <Border x:Name="BorderRight" Grid.Column="2"
                        Background="{StaticResource PanelBg}"
                        BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1" CornerRadius="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource PanelHeaderBg}"
                                CornerRadius="4,4,0,0" Padding="12,0">
                            <Grid>
                                <StackPanel x:Name="StackHeaderDownload" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtHeaderDownload"
                                               Style="{StaticResource PanelHeaderText}"
                                               Text="DOWNLOAD QUEUE"/>
                                    <Label x:Name="LblItemCount" Content="0 Items"
                                           VerticalAlignment="Center"
                                           FontSize="11" Foreground="#888888"
                                           Padding="10,0,0,0"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Border Background="#1C1C1C" CornerRadius="2"
                                            BorderBrush="#3C3C3C" BorderThickness="1"
                                            Width="130" Height="22" Margin="0,0,6,0">
                                        <TextBox x:Name="TxtSearchDownload"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="#CCCCCC" FontSize="10"
                                                 VerticalAlignment="Center"
                                                 Controls:TextBoxHelper.Watermark="Filter…"
                                                 Controls:TextBoxHelper.UseFloatingWatermark="False"
                                                 TextChanged="TxtSearchDownload_TextChanged"/>
                                    </Border>
                                    <Button x:Name="BtnMaxRight" Content="⤢"
                                            Style="{StaticResource PanelIconButton}"
                                            Click="BtnMaxRight_Click"
                                            ToolTip="Maximize panel"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1" x:Name="GridDownload"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" SelectionMode="Single"
                                  GridLinesVisibility="None" RowHeight="36"
                                  Background="Transparent" BorderThickness="0"
                                  ColumnHeaderStyle="{StaticResource ColHeader}"
                                  CellStyle="{StaticResource Cell}">

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                            <Setter Property="Background" Value="#162D16"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID"       Binding="{Binding Id}"       Width="SizeToCells" MinWidth="46"/>
                                <DataGridTextColumn Header="FILENAME" Binding="{Binding Filename}" Width="4*"/>
                                <DataGridTextColumn Header="DATE"     Binding="{Binding PubDate}"  Width="110"/>

                                <DataGridTemplateColumn Header="FOLDER" Width="*" SortMemberPath="FolderShort">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FolderShort}"
                                                       ToolTip="{Binding Path}"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Visibility="Hidden" Width="0" Header="Path"       Binding="{Binding Path}"/>
                                <DataGridTextColumn Visibility="Hidden" Width="0" Header="Magnet"     Binding="{Binding Magnet}"/>
                                <DataGridTextColumn Visibility="Hidden" Width="0" Header="MagnetHash" Binding="{Binding MagnetHash}"/>

                                <DataGridTemplateColumn Header="" Width="184">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Delete button — asks for confirmation, then removes the entry on the backend -->
                                            <Button Grid.Column="0" Click="BtnDeleteEntry_Click"
                                                    Width="30" Padding="0" Margin="0,0,6,0"
                                                    Content="&#xE74D;"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    ToolTip="Delete entry">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource RowButton}">
                                                        <Setter Property="Opacity" Value="0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                <Setter Property="Opacity" Value="1"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsInTransmission}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Grid Grid.Column="1">
                                                <!-- Download button — visible when not in Transmission -->
                                                <Button Click="BtnDownload_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource RowButton}">
                                                            <Setter Property="Content" Value="{DynamicResource KeyDownload}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInTransmission}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard x:Name="PulseStoryboard">
                                                                            <Storyboard RepeatBehavior="Forever">
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                                 From="0.65" To="0.25"
                                                                                                 Duration="0:0:0.7"
                                                                                                 AutoReverse="True"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions>
                                                                        <StopStoryboard BeginStoryboardName="PulseStoryboard"/>
                                                                    </DataTrigger.ExitActions>
                                                                    <Setter Property="Content"   Value="Adding…"/>
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                    <Setter Property="Opacity"   Value="0.35"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Progress display — visible while torrent is in Transmission -->
                                                <StackPanel VerticalAlignment="Center" Margin="8,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInTransmission}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <ProgressBar Value="{Binding Progress}" Maximum="1" Height="3"
                                                                 Foreground="#9CDCFE" Background="#252525"
                                                                 BorderThickness="0"/>
                                                    <Grid Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding ProgressText}" FontSize="10"
                                                                   Foreground="#9CDCFE" HorizontalAlignment="Left"/>
                                                        <TextBlock Text="{Binding EtaText}" FontSize="9"
                                                                   Foreground="#666" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding SpeedText}" FontSize="9"
                                                               Foreground="#555" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="1" x:Name="PanelDownloadEmpty"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Background="#2D2D2D" CornerRadius="40"
                                    Width="72" Height="72" HorizontalAlignment="Center">
                                <TextBlock Text="↓" FontSize="38" FontFamily="Segoe UI"
                                           Foreground="#666666"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="TxtEmptyDlTitle"
                                       Text="Download queue is empty"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#AAAAAA"
                                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            <TextBlock x:Name="TxtEmptyDlSub"
                                       Text="New episodes will appear here automatically."
                                       FontSize="11" Foreground="#666666"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" x:Name="PanelDownloadError"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Background="#2E1F1F" CornerRadius="40"
                                    Width="72" Height="72" HorizontalAlignment="Center">
                                <TextBlock Text="⚠" FontSize="30" Foreground="#D97070"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="TxtErrDlTitle"
                                       Text="Could not load download queue"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#AAAAAA"
                                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            <TextBlock x:Name="TxtErrDlSub"
                                       Text="Check your connection and settings."
                                       FontSize="11" Foreground="#666666"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border x:Name="PanelRightCollapsedOverlay"
                                Grid.Row="1"
                                Background="{StaticResource PanelBg}"
                                Visibility="Collapsed"
                                Panel.ZIndex="10"
                                Cursor="Hand"
                                MouseLeftButtonDown="PanelCollapsedOverlay_Click"
                                ToolTip="Click to restore layout">
                            <TextBlock x:Name="TxtCollapsedRight"
                                       Text="DOWNLOAD QUEUE"
                                       Foreground="#909090"
                                       FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="-90"/>
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </Border>

                    </Grid>
                </Border>
            </Grid>

            <!-- ── Action buttons ──────────────────────────────────── -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Button x:Name="BtnSettings"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Width="160" Content="Settings"
                        Style="{StaticResource ActionButton}"
                        Click="BtnSettings_Click"/>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button x:Name="BtnResumeAll"
                            Width="148" Margin="0,0,8,0" Content="▶  Resume All"
                            Style="{StaticResource ActionButton}"
                            Click="BtnResumeAll_Click"/>
                    <Button x:Name="BtnPauseAll"
                            Width="148" Margin="0,0,8,0" Content="⏸  Pause All"
                            Style="{StaticResource ActionButton}"
                            Click="BtnPauseAll_Click"/>
                    <!-- Split button: main area + delay-dropdown side -->
                    <Button x:Name="BtnDownloadAll"
                            Width="154" Content="↓  Download All"
                            Style="{StaticResource DownloadAllButtonMain}"
                            Click="BtnDownloadAll_Click"/>
                    <Button x:Name="BtnDownloadAllDropdown"
                            Style="{StaticResource DownloadAllButtonSide}"
                            ToolTip="Select download delay"
                            Click="BtnDownloadAllDropdown_Click">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtDelayIndicator"
                                       Text="5 s" FontSize="9" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="▾" FontSize="8"
                                       HorizontalAlignment="Center" Margin="0,-1,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             ROW 1 — Library Manager view (hidden until nav tab clicked)
        ══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="ViewLibraryManager" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="250" MinHeight="100"/>  <!-- watched folders + rules -->
                <RowDefinition Height="5"/>                    <!-- row splitter            -->
                <RowDefinition Height="44"/>                   <!-- search bar + Move All   -->
                <RowDefinition Height="Auto"/>                 <!-- scan progress (hidden)  -->
                <RowDefinition Height="*"   MinHeight="120"/>  <!-- source | target grids   -->
            </Grid.RowDefinitions>

            <!-- ── Top: watched folders (left) + rules (right) ─────── -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="370"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Watched Folders panel -->
                <Border Grid.Column="0"
                        Background="{StaticResource PanelBg}"
                        BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1" CornerRadius="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="44"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource PanelHeaderBg}"
                                CornerRadius="4,4,0,0" Padding="12,0">
                            <TextBlock x:Name="TxtHeaderWatchedFolders" Text="WATCHED FOLDERS"
                                       Style="{StaticResource PanelHeaderText}"/>
                        </Border>
                        <Grid Grid.Row="1">
                            <ListBox x:Name="LstWatchedFolders"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="#CCCCCC" FontSize="11"
                                     FontFamily="Consolas" Padding="4,4,4,4">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⚠ " Foreground="#F44747" VerticalAlignment="Center"
                                                       Visibility="{Binding IsAvailable, Converter={StaticResource InvBoolToVisible}}"/>
                                            <TextBlock Text="{Binding Path}" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#CCCCCC"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                <Setter Property="Foreground" Value="#F44747"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="No watched folders yet.&#x0a;Click + Add Folder to start."
                                       Foreground="#585858" FontSize="11" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=LstWatchedFolders}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <DockPanel Grid.Row="2" LastChildFill="False"
                                   VerticalAlignment="Center" Margin="10,0">
                            <Button x:Name="BtnLibAddFolder" DockPanel.Dock="Left"
                                    Style="{StaticResource ActionButton}"
                                    Height="28" FontSize="11" Padding="10,0"
                                    Content="+ Add Folder" Click="BtnLibAddFolder_Click" Margin="0,0,6,0"/>
                            <Button x:Name="BtnLibRemoveFolder" DockPanel.Dock="Left"
                                    Style="{StaticResource ActionButton}"
                                    Height="28" FontSize="11" Padding="10,0"
                                    Content="Remove" Click="BtnLibRemoveFolder_Click"/>
                            <Button x:Name="BtnLibScan" DockPanel.Dock="Right"
                                    Style="{StaticResource ActionButton}"
                                    Height="28" FontSize="11" Padding="10,0"
                                    Content="Scan + Update" Click="BtnLibScan_Click"/>
                        </DockPanel>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                              Background="#3C3C3C" Cursor="SizeWE"/>

                <!-- Rules panel -->
                <Border Grid.Column="2"
                        Background="{StaticResource PanelBg}"
                        BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1" CornerRadius="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="44"/>
                            <RowDefinition x:Name="RuleTestRow" Height="0"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource PanelHeaderBg}"
                                CornerRadius="4,4,0,0" Padding="12,0">
                            <TextBlock x:Name="TxtHeaderRules" Text="RULES"
                                       Style="{StaticResource PanelHeaderText}"/>
                        </Border>
                        <Grid Grid.Row="1">
                            <DataGrid x:Name="GridRules"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="True" SelectionMode="Single"
                                      GridLinesVisibility="None" RowHeight="34"
                                      Background="Transparent" BorderThickness="0"
                                      ColumnHeaderStyle="{StaticResource ColHeader}"
                                      CellStyle="{StaticResource Cell}"
                                      MouseDoubleClick="GridRules_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NAME"    Binding="{Binding Name}"             Width="110"/>
                                    <DataGridTextColumn Header="SOURCE"  Binding="{Binding SourcePath}"       Width="*"/>
                                    <DataGridTextColumn Header="MATCH"   Binding="{Binding MatchModeDisplay}" Width="110"/>
                                    <DataGridTextColumn Header="TARGET"  Binding="{Binding TargetBasePath}"   Width="*"/>
                                    <DataGridTextColumn Header="OPTIONS" Binding="{Binding OptionsDisplay}"   Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="No rules yet — click + Add Rule to organise your library."
                                       Foreground="#585858" FontSize="11" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=GridRules}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="10,0">
                            <Button x:Name="BtnLibAddRule" Style="{StaticResource ActionButton}"
                                    Height="28" FontSize="11" Padding="10,0"
                                    Content="+ Add Rule" Click="BtnLibAddRule_Click" Margin="0,0,6,0"/>
                            <Button x:Name="BtnLibEditRule" Style="{StaticResource ActionButton}"
                                    Height="28" FontSize="11" Padding="10,0"
                                    Content="Edit" Click="BtnLibEditRule_Click" Margin="0,0,6,0"/>
                            <Button x:Name="BtnLibRemoveRule" Style="{StaticResource ActionButton}"
                                    Height="28" FontSize="11" Padding="10,0"
                                    Content="Remove" Click="BtnLibRemoveRule_Click" Margin="0,0,6,0"/>
                            <Button x:Name="BtnLibTestRule" Style="{StaticResource ActionButton}"
                                    Height="28" FontSize="11" Padding="10,0"
                                    Content="Test Rule" Click="BtnLibTestRule_Click"/>
                        </StackPanel>

                        <!-- Inline rule-test panel (hidden by default, toggled by Test Rule button) -->
                        <Border Grid.Row="3" Background="#1A1A1A"
                                BorderBrush="{StaticResource PanelBorder}"
                                BorderThickness="0,1,0,0" Padding="10,6">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtRuleTestInput"
                                             Background="#252526" BorderBrush="#3C3C3C" BorderThickness="1"
                                             Foreground="#CCCCCC" FontSize="11" FontFamily="Consolas"
                                             VerticalAlignment="Center" Padding="6,3"
                                             Controls:TextBoxHelper.Watermark="Type a filename to test…"
                                             Controls:TextBoxHelper.UseFloatingWatermark="False"
                                             KeyDown="TxtRuleTestInput_KeyDown"/>
                                    <Button Grid.Column="1" Content="▶ Test"
                                            Style="{StaticResource ActionButton}"
                                            Height="26" FontSize="11" Padding="8,0"
                                            Margin="6,0,0,0"
                                            Click="BtnRunRuleTest_Click"/>
                                    <Button Grid.Column="2" Content="✕"
                                            Style="{StaticResource PanelIconButton}"
                                            Width="24" Margin="4,0,0,0"
                                            Click="BtnCloseRuleTest_Click"
                                            ToolTip="Close test panel"/>
                                </Grid>
                                <TextBlock x:Name="TxtRuleTestResult"
                                           FontSize="11" FontFamily="Consolas"
                                           Foreground="#666" TextWrapping="Wrap"
                                           Margin="0,4,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── Row splitter ─────────────────────────────────────── -->
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"
                          Background="#3C3C3C"/>

            <!-- ── Search bar + Move All ─────────────────────────────── -->
            <Grid Grid.Row="2" Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#1C1C1C" CornerRadius="3"
                        BorderBrush="#3C3C3C" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Margin="8,0">
                        <TextBlock Text="🔍" FontSize="11" Foreground="#555"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TxtLibSearch"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#CCCCCC" FontSize="12"
                                 VerticalAlignment="Center"
                                 Controls:TextBoxHelper.Watermark="Filter by filename or franchise…"
                                 Controls:TextBoxHelper.UseFloatingWatermark="False"
                                 TextChanged="TxtLibSearch_TextChanged"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button x:Name="BtnUndo"
                            Width="90" Margin="0,0,6,0"
                            Content="⟵ Undo"
                            Style="{StaticResource ActionButton}"
                            IsEnabled="False"
                            Click="BtnUndo_Click"
                            ToolTip="Undo last move"/>
                    <Button x:Name="BtnMoveAll"
                            Width="130" Content="Move All →"
                            Style="{StaticResource DownloadAllButton}"
                            Click="BtnMoveAll_Click"/>
                </StackPanel>
            </Grid>

            <!-- ── Scan progress bar (visible only while scanning) ────── -->
            <Grid x:Name="ScanProgressRow" Grid.Row="3"
                  Margin="0,0,0,4" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="ScanProgressBar" Grid.Column="0"
                             Height="3" Minimum="0" Maximum="100" Value="0"
                             Foreground="#9CDCFE" Background="#1C1C1C"
                             BorderThickness="0"/>
                <TextBlock x:Name="TxtScanEta" Grid.Column="1"
                           Margin="10,0,0,0" Foreground="#666" FontSize="10"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- ── Combined scan results grid ──────────────────────────── -->
            <Border Grid.Row="4"
                    Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource PanelHeaderBg}"
                            CornerRadius="4,4,0,0" Padding="6,0,12,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button x:Name="BtnTabScanResults"
                                        Content="SCAN RESULTS" Tag="active"
                                        Style="{StaticResource SubTab}"
                                        Click="BtnTabScanResults_Click"/>
                                <Button x:Name="BtnTabMoveQueue"
                                        Content="MOVE QUEUE"
                                        Style="{StaticResource SubTab}"
                                        Click="BtnTabMoveQueue_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtScanResultsCount"
                                       Foreground="#555" FontSize="10"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <DataGrid x:Name="GridFiles"
                                  ItemsSource="{Binding Source={StaticResource ScanResultsView}}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Extended" SelectionUnit="FullRow"
                                  GridLinesVisibility="None" RowHeight="28"
                                  Background="Transparent" BorderThickness="0"
                                  ColumnHeaderStyle="{StaticResource ColHeader}"
                                  CellStyle="{StaticResource Cell}"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.IsDeferredScrollingEnabled="True">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Move Selected"            Click="MenuItemMoveSelected_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Change Target Directory…" Click="MenuItemChangeTargetDir_Click"/>
                                    <MenuItem Header="Change Target Name…"      Click="MenuItemChangeTargetName_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Remove Custom Directory"  Click="MenuItemRemoveCustomDir_Click"/>
                                    <MenuItem Header="Remove Custom Name"       Click="MenuItemRemoveCustomName_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Delete File(s)…"          Click="MenuItemDeleteSelected_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SOURCE"    Binding="{Binding SourceFilePath}" Width="2*"/>
                                <DataGridTemplateColumn Header="FRANCHISE" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="10,0" VerticalAlignment="Center">
                                                <TextBlock Text="···" Foreground="#444" FontSize="14" VerticalAlignment="Center"
                                                           Visibility="{Binding IsResolvingMeta, Converter={StaticResource BoolToVisible}}"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding IsResolvingMeta, Converter={StaticResource InvBoolToVisible}}">
                                                    <Border Background="#2E2640" BorderBrush="#4A3F66" BorderThickness="1"
                                                            CornerRadius="2" Padding="3,0" Margin="0,0,5,0"
                                                            VerticalAlignment="Center"
                                                            ToolTip="{Binding CacheBadgeTooltip}"
                                                            Visibility="{Binding IsFromCache, Converter={StaticResource BoolToVisible}}">
                                                        <TextBlock Text="⛁ cached" Foreground="#B9A6E6" FontSize="9"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding FranchiseName}"
                                                               Foreground="{Binding FranchiseForeground}"
                                                               ToolTip="{Binding FranchiseTooltip}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="SEASON" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="10,0" VerticalAlignment="Center">
                                                <TextBlock Text="···" Foreground="#444" FontSize="14" VerticalAlignment="Center"
                                                           Visibility="{Binding IsResolvingMeta, Converter={StaticResource BoolToVisible}}"/>
                                                <TextBlock Text="{Binding SeasonName}"
                                                           Foreground="{Binding SeasonForeground}"
                                                           ToolTip="{Binding SeasonTooltip}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsResolvingMeta, Converter={StaticResource InvBoolToVisible}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Arrow separator -->
                                <DataGridTemplateColumn Header="" Width="28">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="→" Foreground="#404040"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="13"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Target: name + ★ badge + full-path tooltip -->
                                <DataGridTemplateColumn Header="TARGET" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                                <TextBlock Text="★ " Foreground="#9CDCFE" FontSize="10"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding HasCustomPath, Converter={StaticResource BoolToVisible}}"/>
                                                <TextBlock Text="{Binding EffectiveTargetPath}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding EffectiveTargetPath}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Status + per-row Move / Delete buttons / progress bar -->
                                <DataGridTemplateColumn Header="STATUS" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Status}"
                                                           Foreground="{Binding StatusBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0,4,0" FontSize="11"/>
                                                <Grid Grid.Column="1" Margin="0,0,4,0">
                                                    <StackPanel Orientation="Horizontal"
                                                                Visibility="{Binding IsMoving, Converter={StaticResource InvBoolToVisible}}">
                                                        <Button Content="→" Height="20"
                                                                Style="{StaticResource RowButton}"
                                                                Padding="4,0" Margin="0,0,4,0"
                                                                ToolTip="Move this file"
                                                                Click="BtnMoveOne_Click"/>
                                                        <Button Content="🗑" Height="20"
                                                                Style="{StaticResource RowButton}"
                                                                Padding="4,0"
                                                                ToolTip="Delete this file from disk"
                                                                Click="BtnDeleteOne_Click"/>
                                                    </StackPanel>
                                                    <ProgressBar IsIndeterminate="True"
                                                                 Height="6"
                                                                 Foreground="#78C878" Background="#1A3020"
                                                                 Visibility="{Binding IsMoving, Converter={StaticResource BoolToVisible}}"/>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!-- Empty state — shown when no scan has been run yet or no files found -->
                        <TextBlock x:Name="TxtGridEmpty"
                                   Text="No scan results yet — add a watched folder and click Scan + Update."
                                   Foreground="#585858" FontSize="11" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Visible" IsHitTestVisible="False"/>
                        <!-- Empty state — Move Queue tab with nothing left to move -->
                        <TextBlock x:Name="TxtMoveQueueEmpty"
                                   Text="Move Queue is empty — items appear here while a move you started is in progress."
                                   Foreground="#585858" FontSize="11" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed" IsHitTestVisible="False"/>
                        <!-- Loading overlay — shown during Phase 1 (folder scan) before results appear -->
                        <StackPanel x:Name="GridLoadingPanel"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="Collapsed" IsHitTestVisible="False">
                            <TextBlock Text="···" Foreground="#555" FontSize="22"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtGridLoadingDetail"
                                       Text="Scanning folders…"
                                       Foreground="#585858" FontSize="11" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             ROW 1 — Duplicate Finder view (hidden until nav tab clicked)
        ══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="ViewDuplicateFinder" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>    <!-- folders | duplicates -->
                <RowDefinition Height="52"/>   <!-- action-button strip  -->
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" MinWidth="220"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                </Grid.ColumnDefinitions>

                <!-- ── LEFT: Folders (drag to reorder) ─────────────────── -->
                <Border Grid.Column="0"
                        Background="{StaticResource PanelBg}"
                        BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1" CornerRadius="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="44"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource PanelHeaderBg}"
                                CornerRadius="4,4,0,0" Padding="12,0">
                            <TextBlock Text="FOLDERS  (drag to reorder — top = keep)"
                                       Style="{StaticResource PanelHeaderText}"/>
                        </Border>
                        <Grid Grid.Row="1">
                            <ListBox x:Name="LstDupFolders"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="#CCCCCC" FontSize="11"
                                     FontFamily="Consolas" Padding="4"
                                     AllowDrop="True"
                                     HorizontalContentAlignment="Stretch"
                                     PreviewMouseLeftButtonDown="LstDupFolders_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="LstDupFolders_PreviewMouseMove"
                                     Drop="LstDupFolders_Drop">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="⋮⋮" Foreground="#555"
                                                       Margin="2,0,8,0" VerticalAlignment="Center"
                                                       ToolTip="Drag to reorder"/>
                                            <TextBlock Grid.Column="1" Text="⚠ " Foreground="#F44747"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsAvailable, Converter={StaticResource InvBoolToVisible}}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Path}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Path}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#CCCCCC"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                <Setter Property="Foreground" Value="#F44747"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="No folders yet.&#x0a;Click + Add Folder to start."
                                       Foreground="#585858" FontSize="11" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=LstDupFolders}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <DockPanel Grid.Row="2" LastChildFill="False"
                                   VerticalAlignment="Center" Margin="10,0">
                            <Button x:Name="BtnDupAddFolder" DockPanel.Dock="Left"
                                    Style="{StaticResource ActionButton}"
                                    Height="28" FontSize="11" Padding="10,0"
                                    Content="+ Add Folder" Click="BtnDupAddFolder_Click" Margin="0,0,6,0"/>
                            <Button x:Name="BtnDupRemoveFolder" DockPanel.Dock="Left"
                                    Style="{StaticResource ActionButton}"
                                    Height="28" FontSize="11" Padding="10,0"
                                    Content="Remove" Click="BtnDupRemoveFolder_Click"/>
                        </DockPanel>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                              Background="#3C3C3C" Cursor="SizeWE"/>

                <!-- ── RIGHT: Duplicates ───────────────────────────────── -->
                <Border Grid.Column="2"
                        Background="{StaticResource PanelBg}"
                        BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1" CornerRadius="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="Auto"/>  <!-- progress bar -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource PanelHeaderBg}"
                                CornerRadius="4,4,0,0" Padding="12,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="DUPLICATES" Style="{StaticResource PanelHeaderText}"/>
                                    <Label x:Name="LblDupCount" Content="0 groups"
                                           VerticalAlignment="Center"
                                           FontSize="11" Foreground="#888888"
                                           Padding="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtDupReclaimable"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="#57C46E" FontSize="11" FontWeight="SemiBold"/>
                            </Grid>
                        </Border>

                        <!-- progress bar (visible only while scanning) -->
                        <Grid x:Name="DupProgressRow" Grid.Row="1"
                              Margin="12,8,12,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <ProgressBar x:Name="DupProgressBar"
                                             Height="4" Minimum="0" Maximum="1" Value="0"
                                             Foreground="#9CDCFE" Background="#1C1C1C"
                                             BorderThickness="0"/>
                                <TextBlock x:Name="TxtDupProgressFile"
                                           Foreground="#666" FontSize="9.5"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,6"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtDupProgressStat" Grid.Column="1"
                                       Margin="10,0,0,0" Foreground="#888" FontSize="10"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="2">
                            <DataGrid x:Name="GridDuplicates"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Extended" SelectionUnit="FullRow"
                                      GridLinesVisibility="None" RowHeight="34"
                                      Background="Transparent" BorderThickness="0"
                                      ColumnHeaderStyle="{StaticResource ColHeader}"
                                      CellStyle="{StaticResource Cell}"
                                      RowDetailsVisibilityMode="Visible"
                                      SelectionChanged="GridDuplicates_SelectionChanged"
                                      EnableRowVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Cleanup Selected (delete marked copies)"
                                                  Click="MenuItemDupCleanupSelected_Click"/>
                                        <MenuItem Header="Resolve…"
                                                  Click="MenuItemDupResolve_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Ignore Selected"
                                                  Click="MenuItemDupIgnore_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="FILE"        Binding="{Binding FileName}"        Width="2*"/>
                                    <DataGridTextColumn Header="SIZE"        Binding="{Binding SizeText}"        Width="90"/>
                                    <DataGridTextColumn Header="COPIES"      Binding="{Binding CopyCount}"       Width="70"/>
                                    <DataGridTextColumn Header="RECLAIMABLE" Binding="{Binding ReclaimableText}" Width="110"/>
                                    <DataGridTemplateColumn Header="" Width="250">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                            Margin="6,0">
                                                    <Button Content="Cleanup" Height="24"
                                                            Style="{StaticResource RowButton}"
                                                            Margin="0,0,6,0"
                                                            ToolTip="Delete the copies marked DELETE (undecided groups keep the first file, with a warning)"
                                                            Click="BtnDupCleanupOne_Click"/>
                                                    <Button Content="Resolve…" Height="24"
                                                            Style="{StaticResource RowButton}"
                                                            Margin="0,0,6,0"
                                                            ToolTip="Choose which copies to keep"
                                                            Click="BtnDupResolveOne_Click"/>
                                                    <Button Content="Ignore" Height="24"
                                                            Style="{StaticResource RowButton}"
                                                            ToolTip="Hide this group and skip it in future scans"
                                                            Click="BtnDupIgnoreOne_Click"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                                <DataGrid.RowDetailsTemplate>
                                    <DataTemplate>
                                        <Border Background="#1B1B1B" Padding="30,4,10,6"
                                                BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
                                            <ItemsControl ItemsSource="{Binding Files}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="{Binding RowMargin}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="72"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0" Content="▶"
                                                                    Height="18" FontSize="8"
                                                                    Padding="6,0" Margin="0,0,8,0"
                                                                    Style="{StaticResource RowButton}"
                                                                    ToolTip="Open in default media player"
                                                                    Click="BtnDupPlayOne_Click"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding ActionText}"
                                                                       Foreground="{Binding ActionBrush}"
                                                                       FontSize="9.5" FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding FullPath}"
                                                                       Foreground="{Binding PathBrush}"
                                                                       FontFamily="Consolas" FontSize="10.5"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding FullPath}"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </DataTemplate>
                                </DataGrid.RowDetailsTemplate>
                            </DataGrid>

                            <TextBlock x:Name="TxtDupEmpty"
                                       Text="No duplicates found yet — add folders and click Find Duplicates."
                                       Foreground="#585858" FontSize="11" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Visible" IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── Action buttons ──────────────────────────────────────── -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <TextBlock x:Name="TxtDupSummary"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Foreground="#888888" FontSize="12"/>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button x:Name="BtnDupCleanupSelected"
                            Width="180" Margin="0,0,8,0" Content="🗑  Cleanup Selected"
                            Style="{StaticResource ActionButton}"
                            IsEnabled="False"
                            Click="BtnDupCleanupSelected_Click"/>
                    <Button x:Name="BtnFindDuplicates"
                            Width="170" Content="⚙  Find Duplicates"
                            Style="{StaticResource DownloadAllButton}"
                            Click="BtnFindDuplicates_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             ROW 2 — Event log (collapsible)
        ══════════════════════════════════════════════════════════════ -->
        <Border x:Name="BorderEventLog" Grid.Row="2"
                Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1" CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource PanelHeaderBg}"
                        CornerRadius="4,4,0,0" Padding="12,0">
                    <Grid>
                        <TextBlock x:Name="TxtHeaderLog"
                                   Text="EVENT LOG"
                                   Style="{StaticResource PanelHeaderText}"/>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnExportLog" Content="⬆ Export"
                                    Style="{StaticResource PanelIconButton}"
                                    Width="58" FontSize="10"
                                    Margin="0,0,4,0"
                                    Click="BtnExportLog_Click"
                                    ToolTip="Export log to file"/>
                            <Button x:Name="BtnLogToggle" Content="▼"
                                    Style="{StaticResource PanelIconButton}"
                                    Click="BtnLogToggle_Click"
                                    ToolTip="Collapse / expand log"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <RichTextBox Grid.Row="1" x:Name="TxtEventLog"
                             IsReadOnly="True"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11.5"
                             Foreground="#9CDCFE"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="12,6"/>
            </Grid>
        </Border>

    </Grid>
</Controls:MetroWindow>
