<Controls:MetroWindow x:Class="Kizuna.ConfirmDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        Title="Delete entry"
        Height="210" Width="520"
        WindowStartupLocation="CenterOwner"
        ShowMinButton="False" ShowMaxRestoreButton="False"
        ResizeMode="NoResize">

    <Grid Margin="22,16,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>     <!-- filename -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- buttons -->
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtHeader" Grid.Row="0"
                   Foreground="#DDDDDD" FontSize="14" FontWeight="SemiBold"
                   TextWrapping="Wrap"/>

        <Border Grid.Row="2" Background="#1E1E1E" BorderBrush="#3C3C3C" BorderThickness="1"
                CornerRadius="4" Padding="10,8">
            <TextBlock x:Name="TxtFilename"
                       Foreground="#9CDCFE" FontFamily="Consolas" FontSize="11"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Width="110" Margin="0,0,8,0"
                    IsCancel="True" IsDefault="True" Click="BtnCancel_Click"
                    Style="{DynamicResource SquareButtonStyle}"/>
            <Button x:Name="BtnConfirm" Width="110"
                    Click="BtnConfirm_Click"
                    Style="{DynamicResource AccentedSquareButtonStyle}"/>
        </StackPanel>
    </Grid>
</Controls:MetroWindow>
