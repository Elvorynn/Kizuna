<Controls:MetroWindow x:Class="Kizuna.DuplicateDefaultResolveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:local="clr-namespace:Kizuna"
        Title="Confirm Cleanup"
        Height="520" Width="760"
        WindowStartupLocation="CenterOwner"
        ShowMinButton="False" ShowMaxRestoreButton="False">

    <Controls:MetroWindow.Resources>
        <local:BoolToVisibleConverter x:Key="BoolToVisible"/>
    </Controls:MetroWindow.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- warning banner -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>     <!-- group list -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>  <!-- summary -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- buttons -->
        </Grid.RowDefinitions>

        <!-- Warning banner (only for undecided/same-folder groups) -->
        <Border x:Name="WarningBanner" Grid.Row="0"
                Background="#3A2E12" BorderBrush="#7A5A1E" BorderThickness="1"
                CornerRadius="4" Padding="12,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⚠" Foreground="#FFC066" FontSize="20"
                           VerticalAlignment="Top" Margin="0,0,10,0"/>
                <TextBlock TextWrapping="Wrap" Foreground="#E8D9B0" FontSize="12"
                           MaxWidth="640"
                           Text="Some of these groups have no clear winner — every copy lives in the same folder. By default the first file listed is kept and all others are deleted. Review the outcome below before continuing."/>
            </StackPanel>
        </Border>

        <!-- Per-group outcome -->
        <Border Grid.Row="2" Background="#1E1E1E" BorderBrush="#3C3C3C" BorderThickness="1"
                CornerRadius="4">
            <ItemsControl x:Name="LstGroups" Margin="6">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#252526" CornerRadius="4" Padding="10,8" Margin="2,3">
                            <StackPanel>
                                <!-- group header -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding FileName}"
                                               Foreground="#DDDDDD" FontWeight="SemiBold"
                                               FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Border Background="#3A2E12" BorderBrush="#7A5A1E" BorderThickness="1"
                                                CornerRadius="2" Padding="4,0" Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsAmbiguous, Converter={StaticResource BoolToVisible}}">
                                            <TextBlock Text="SAME FOLDER" Foreground="#FFC066" FontSize="9"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding SizeText}" Foreground="#888" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding CopyCount, StringFormat={}{0} copies}"
                                                   Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <!-- files with outcome -->
                                <ItemsControl ItemsSource="{Binding Files}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="{Binding RowMargin}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="62"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="▶" Height="18" FontSize="8"
                                                        Padding="6,0" Margin="0,0,8,0" MinWidth="24"
                                                        ToolTip="Open in default media player"
                                                        Click="BtnPlay_Click"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ActionText}"
                                                           Foreground="{Binding ActionBrush}"
                                                           FontSize="9.5" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding FullPath}"
                                                           Foreground="{Binding PathBrush}"
                                                           FontFamily="Consolas" FontSize="10.5"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FullPath}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock Grid.Row="4" x:Name="TxtSummary"
                   Foreground="#9CDCFE" FontSize="12"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="110" Margin="0,0,8,0"
                    IsCancel="True" Click="BtnCancel_Click"
                    Style="{DynamicResource SquareButtonStyle}"/>
            <Button x:Name="BtnConfirm" Content="Delete"
                    Width="200" IsDefault="True" Click="BtnOk_Click"
                    Style="{DynamicResource AccentedSquareButtonStyle}"/>
        </StackPanel>
    </Grid>
</Controls:MetroWindow>
