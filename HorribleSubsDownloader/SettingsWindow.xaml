<Controls:MetroWindow x:Class="Kizuna.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        Title="Settings" Height="700" Width="580"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowMinButton="False" ShowMaxRestoreButton="False">

    <Controls:MetroWindow.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="Margin"     Value="0,16,0,5"/>
        </Style>
        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#CF6679"/>
            <Setter Property="Margin"     Value="2,3,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="SettingsCheck" TargetType="CheckBox">
            <Setter Property="Margin"     Value="0,5,0,0"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
        </Style>
        <Style x:Key="SubLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="Margin"     Value="0,8,0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Controls:MetroWindow.Resources>

    <Grid Margin="24,14,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>    <!-- scrollable content -->
            <RowDefinition Height="Auto"/> <!-- buttons -->
        </Grid.RowDefinitions>

        <!-- ── Scrollable settings content ──────────────────────────────── -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>

                <!-- ── API ──────────────────────────────────────────────── -->
                <TextBlock x:Name="TxtSectionApi" Text="API"
                           Style="{StaticResource SectionLabel}" Margin="0,4,0,5"/>

                <TextBox x:Name="TxtApiBaseUrl"
                         Controls:TextBoxHelper.Watermark="https://example.com/api/client/"
                         Controls:TextBoxHelper.UseFloatingWatermark="False"
                         TextChanged="TxtField_TextChanged"
                         LostFocus="TxtApiBaseUrl_LostFocus"/>
                <TextBlock x:Name="ErrApiBaseUrl" Style="{StaticResource FieldError}"
                           Text="⚠  Valid http/https URL required"/>

                <TextBox x:Name="TxtUsername" Margin="0,7,0,0"
                         Controls:TextBoxHelper.Watermark="Username"
                         Controls:TextBoxHelper.UseFloatingWatermark="False"
                         TextChanged="TxtField_TextChanged"
                         LostFocus="TxtUsername_LostFocus"/>
                <TextBlock x:Name="ErrUsername" Style="{StaticResource FieldError}"
                           Text="⚠  Username is required"/>

                <TextBox x:Name="TxtApiToken" Margin="0,7,0,0"
                         Controls:TextBoxHelper.Watermark="64-character API token"
                         Controls:TextBoxHelper.UseFloatingWatermark="False"
                         TextChanged="TxtField_TextChanged"
                         LostFocus="TxtApiToken_LostFocus"/>
                <TextBlock x:Name="ErrApiToken" Style="{StaticResource FieldError}"
                           Text="⚠  API token is required"/>

                <!-- ── Transmission ──────────────────────────────────────── -->
                <TextBlock x:Name="TxtSectionTx" Text="TRANSMISSION"
                           Style="{StaticResource SectionLabel}"/>

                <!-- Transmission RPC URL -->
                <TextBlock x:Name="TxtTxUrlLabel" Text="Transmission URL"
                           Style="{StaticResource SubLabel}"/>
                <TextBox x:Name="TxtTransmissionUrl"
                         Controls:TextBoxHelper.Watermark="http://127.0.0.1:9091/transmission/rpc"
                         Controls:TextBoxHelper.UseFloatingWatermark="False"/>

                <!-- ── Language ──────────────────────────────────────────── -->
                <TextBlock x:Name="TxtSectionLang" Text="LANGUAGE"
                           Style="{StaticResource SectionLabel}"/>
                <ComboBox x:Name="CboLanguage">
                    <ComboBoxItem>English</ComboBoxItem>
                    <ComboBoxItem>Deutsch</ComboBoxItem>
                    <ComboBoxItem>Français</ComboBoxItem>
                    <ComboBoxItem>Español</ComboBoxItem>
                    <ComboBoxItem>日本語</ComboBoxItem>
                </ComboBox>

                <!-- ── Paths ─────────────────────────────────────────────── -->
                <TextBlock x:Name="TxtSectionPaths" Text="PATHS"
                           Style="{StaticResource SectionLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="TxtTorrentDownloadPath"
                             Controls:TextBoxHelper.Watermark="C:\Users\YourName\Downloads\Torrents"
                             Controls:TextBoxHelper.UseFloatingWatermark="False"
                             TextChanged="TxtField_TextChanged"
                             LostFocus="TxtTorrentDownloadPath_LostFocus"/>
                    <Button x:Name="BtnBrowse" Grid.Column="1" Content="…"
                            Width="36" Margin="8,0,0,0"
                            VerticalAlignment="Stretch"
                            Click="BtnBrowse_Click"/>
                </Grid>
                <TextBlock x:Name="ErrTorrentDownloadPath" Style="{StaticResource FieldError}"
                           Text="⚠  Valid absolute directory path required"/>

                <!-- ── Behavior ───────────────────────────────────────────── -->
                <TextBlock x:Name="TxtSectionBehavior" Text="BEHAVIOR"
                           Style="{StaticResource SectionLabel}"/>

                <CheckBox x:Name="ChkMinimizeToTray"
                          Content="Minimize to system tray instead of closing"
                          Style="{StaticResource SettingsCheck}"/>

                <CheckBox x:Name="ChkStartWithWindows"
                          Content="Start with Windows"
                          Style="{StaticResource SettingsCheck}" Margin="0,5,0,0"/>

                <CheckBox x:Name="ChkNotifications"
                          Content="Show desktop notifications (download started / complete / error)"
                          Style="{StaticResource SettingsCheck}" Margin="0,5,0,0"/>

                <CheckBox x:Name="ChkAutoRetry"
                          Content="Auto-retry failed downloads (max 3)"
                          Style="{StaticResource SettingsCheck}" Margin="0,5,0,0"/>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Retry delay:"
                               Style="{StaticResource SubLabel}" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1" x:Name="CboRetryDelay"/>
                </Grid>

                <Grid Margin="0,8,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="When target file exists:"
                               Style="{StaticResource SubLabel}" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1" x:Name="CboFileConflict">
                        <ComboBoxItem x:Name="CboConflictAsk"      Content="Ask each time"      Tag="ask"/>
                        <ComboBoxItem x:Name="CboConflictSkip"     Content="Skip"               Tag="skip"/>
                        <ComboBoxItem x:Name="CboConflictOverwrite" Content="Overwrite"         Tag="overwrite"/>
                        <ComboBoxItem x:Name="CboConflictRename"   Content="Rename (add number)" Tag="rename"/>
                    </ComboBox>
                </Grid>

                <CheckBox x:Name="ChkReResolveLibrary"
                          Content="Re-resolve cached library results against the API on each scan"
                          Style="{StaticResource SettingsCheck}" Margin="0,5,0,0"
                          ToolTip="When off, cached results are shown instantly and only new files are resolved."/>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Buttons ────────────────────────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Button x:Name="BtnResetGui"
                    Content="Reset GUI Layout"
                    HorizontalAlignment="Left" Width="160"
                    Click="BtnResetGui_Click"
                    Style="{DynamicResource SquareButtonStyle}"/>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="BtnCancel" Content="Cancel" Width="110" Margin="0,0,10,0"
                        Click="BtnCancel_Click" IsCancel="True"
                        Style="{DynamicResource SquareButtonStyle}"/>
                <Button x:Name="BtnSave" Content="Save" Width="110"
                        Click="BtnSave_Click" IsDefault="True"
                        Style="{DynamicResource AccentedSquareButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Controls:MetroWindow>
