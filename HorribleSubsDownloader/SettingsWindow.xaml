<Controls:MetroWindow x:Class="Kizuna.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        Title="Settings" Height="780" Width="640"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowMinButton="False" ShowMaxRestoreButton="False">

    <Controls:MetroWindow.Resources>
        <!-- Card container for each settings section -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="#252526"/>
            <Setter Property="BorderBrush"     Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="18,14,18,16"/>
            <Setter Property="Margin"          Value="0,0,0,12"/>
        </Style>
        <!-- Card title (text set from code-behind) -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="Foreground"        Value="#9CDCFE"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionIcon" TargetType="TextBlock">
            <Setter Property="FontFamily"        Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize"          Value="14"/>
            <Setter Property="Foreground"        Value="#9CDCFE"/>
            <Setter Property="Margin"            Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#CF6679"/>
            <Setter Property="Margin"     Value="2,3,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="SubLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="Margin"     Value="0,10,0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Label text of a setting row -->
        <Style x:Key="RowText" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="Foreground"        Value="#CCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping"      Value="Wrap"/>
        </Style>
        <Style x:Key="RowCombo" TargetType="ComboBox" BasedOn="{StaticResource MetroComboBox}">
            <Setter Property="Width"               Value="190"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin"              Value="12,0,0,0"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height"     Value="1"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Margin"     Value="0,10,0,10"/>
        </Style>
    </Controls:MetroWindow.Resources>

    <Grid Margin="22,10,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>    <!-- scrollable content -->
            <RowDefinition Height="Auto"/> <!-- buttons -->
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>

                <!-- ── API ──────────────────────────────────────────────── -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xE774;" Style="{StaticResource SectionIcon}"/>
                            <TextBlock x:Name="TxtSectionApi" Text="API" Style="{StaticResource SectionLabel}"/>
                        </StackPanel>

                        <TextBox x:Name="TxtApiBaseUrl"
                                 Controls:TextBoxHelper.Watermark="https://example.com/api/client/"
                                 Controls:TextBoxHelper.UseFloatingWatermark="False"
                                 TextChanged="TxtField_TextChanged"
                                 LostFocus="TxtApiBaseUrl_LostFocus"/>
                        <TextBlock x:Name="ErrApiBaseUrl" Style="{StaticResource FieldError}"
                                   Text="⚠  Valid http/https URL required"/>

                        <TextBox x:Name="TxtUsername" Margin="0,8,0,0"
                                 Controls:TextBoxHelper.Watermark="Username"
                                 Controls:TextBoxHelper.UseFloatingWatermark="False"
                                 TextChanged="TxtField_TextChanged"
                                 LostFocus="TxtUsername_LostFocus"/>
                        <TextBlock x:Name="ErrUsername" Style="{StaticResource FieldError}"
                                   Text="⚠  Username is required"/>

                        <TextBox x:Name="TxtApiToken" Margin="0,8,0,0"
                                 Controls:TextBoxHelper.Watermark="64-character API token"
                                 Controls:TextBoxHelper.UseFloatingWatermark="False"
                                 TextChanged="TxtField_TextChanged"
                                 LostFocus="TxtApiToken_LostFocus"/>
                        <TextBlock x:Name="ErrApiToken" Style="{StaticResource FieldError}"
                                   Text="⚠  API token is required"/>
                    </StackPanel>
                </Border>

                <!-- ── Transmission ──────────────────────────────────────── -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="&#xE896;" Style="{StaticResource SectionIcon}"/>
                            <TextBlock x:Name="TxtSectionTx" Text="TRANSMISSION" Style="{StaticResource SectionLabel}"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtTxUrlLabel" Text="Transmission URL"
                                   Style="{StaticResource SubLabel}"/>
                        <TextBox x:Name="TxtTransmissionUrl"
                                 Controls:TextBoxHelper.Watermark="http://127.0.0.1:9091/transmission/rpc"
                                 Controls:TextBoxHelper.UseFloatingWatermark="False"/>
                    </StackPanel>
                </Border>

                <!-- ── Paths ─────────────────────────────────────────────── -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource SectionIcon}"/>
                            <TextBlock x:Name="TxtSectionPaths" Text="PATHS" Style="{StaticResource SectionLabel}"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtTorrentDownloadPath"
                                     Controls:TextBoxHelper.Watermark="C:\Users\YourName\Downloads\Torrents"
                                     Controls:TextBoxHelper.UseFloatingWatermark="False"
                                     TextChanged="TxtField_TextChanged"
                                     LostFocus="TxtTorrentDownloadPath_LostFocus"/>
                            <Button x:Name="BtnBrowse" Grid.Column="1" Content="…"
                                    Width="40" Margin="8,0,0,0"
                                    VerticalAlignment="Stretch"
                                    Click="BtnBrowse_Click"
                                    Style="{DynamicResource SquareButtonStyle}"/>
                        </Grid>
                        <TextBlock x:Name="ErrTorrentDownloadPath" Style="{StaticResource FieldError}"
                                   Text="⚠  Valid absolute directory path required"/>
                    </StackPanel>
                </Border>

                <!-- ── Language ──────────────────────────────────────────── -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xE774;" Style="{StaticResource SectionIcon}"/>
                            <TextBlock x:Name="TxtSectionLang" Text="LANGUAGE" Style="{StaticResource SectionLabel}"/>
                        </StackPanel>
                        <ComboBox x:Name="CboLanguage">
                            <ComboBoxItem>English</ComboBoxItem>
                            <ComboBoxItem>Deutsch</ComboBoxItem>
                            <ComboBoxItem>Français</ComboBoxItem>
                            <ComboBoxItem>Español</ComboBoxItem>
                            <ComboBoxItem>日本語</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- ── Behavior ───────────────────────────────────────────── -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xE713;" Style="{StaticResource SectionIcon}"/>
                            <TextBlock x:Name="TxtSectionBehavior" Text="BEHAVIOR" Style="{StaticResource SectionLabel}"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Minimize to system tray instead of closing" Style="{StaticResource RowText}"/>
                            <Controls:ToggleSwitch Grid.Column="1" x:Name="ChkMinimizeToTray" OnLabel="" OffLabel="" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Start with Windows" Style="{StaticResource RowText}"/>
                            <Controls:ToggleSwitch Grid.Column="1" x:Name="ChkStartWithWindows" OnLabel="" OffLabel="" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Show desktop notifications (download started / complete / error)" Style="{StaticResource RowText}"/>
                            <Controls:ToggleSwitch Grid.Column="1" x:Name="ChkNotifications" OnLabel="" OffLabel="" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Auto-retry failed downloads (max 3)" Style="{StaticResource RowText}"/>
                            <Controls:ToggleSwitch Grid.Column="1" x:Name="ChkAutoRetry" OnLabel="" OffLabel="" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Retry delay" Style="{StaticResource RowText}"/>
                            <ComboBox Grid.Column="1" x:Name="CboRetryDelay" Style="{StaticResource RowCombo}"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="When target file exists" Style="{StaticResource RowText}"/>
                            <ComboBox Grid.Column="1" x:Name="CboFileConflict" Style="{StaticResource RowCombo}">
                                <ComboBoxItem x:Name="CboConflictAsk"       Content="Ask each time"       Tag="ask"/>
                                <ComboBoxItem x:Name="CboConflictSkip"      Content="Skip"                Tag="skip"/>
                                <ComboBoxItem x:Name="CboConflictOverwrite" Content="Overwrite"           Tag="overwrite"/>
                                <ComboBoxItem x:Name="CboConflictRename"    Content="Rename (add number)" Tag="rename"/>
                            </ComboBox>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>

                        <Grid ToolTip="When off, cached results are shown instantly and only new files are resolved.">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Re-resolve cached library results against the API on each scan" Style="{StaticResource RowText}"/>
                            <Controls:ToggleSwitch Grid.Column="1" x:Name="ChkReResolveLibrary" OnLabel="" OffLabel="" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Buttons ────────────────────────────────────────────────────── -->
        <Border Grid.Row="1" BorderBrush="#333333" BorderThickness="0,1,0,0" Margin="0,8,10,0" Padding="0,14,0,0">
            <Grid>
                <Button x:Name="BtnResetGui"
                        Content="Reset GUI Layout"
                        HorizontalAlignment="Left" Width="160"
                        Click="BtnResetGui_Click"
                        Style="{DynamicResource SquareButtonStyle}"/>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="BtnCancel" Content="Cancel" Width="110" Margin="0,0,10,0"
                            Click="BtnCancel_Click" IsCancel="True"
                            Style="{DynamicResource SquareButtonStyle}"/>
                    <Button x:Name="BtnSave" Content="Save" Width="110"
                            Click="BtnSave_Click" IsDefault="True"
                            Style="{DynamicResource AccentedSquareButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Controls:MetroWindow>
